{
  "name": "sinal-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Empacotamento desktop do Sinal (Electron) — mesmo site de producao, com captura de tela/audio nativa porque o navegador nao resolve o vazamento de audio do Discord nem o segundo plano de verdade. Ver HANDOFF.md secao Electron.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "loopback-capture": "^3.0.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.sinal.desktop",
    "productName": "Sinal",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "build/**/*"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
